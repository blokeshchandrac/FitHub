{
  "ConnectionStrings": {
    "FitHubDatabase": "Host=localhost;Port=5432;Database=fithub;Username=fithub;Password=replace_with_local_password"
  },
  "Jwt": {
    "Issuer": "FitHub.Api",
    "Audience": "FitHub.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Stripe": {
    "WebBaseUrl": "http://localhost:4040"
  },
  "EquipmentDevices": {
    "HeartbeatTimeoutSeconds": 90,
    "MonitorIntervalSeconds": 30
  },
  "FaultPhotos": {
    "LocalPath": "App_Data/fault-images"
  },
  "Simulation": {
    "Enabled": false,
    "ClearanceThresholdMetres": 2.2,
    "ClearanceSeconds": 30,
    "ParkingScanSeconds": 60,
    "ParkingDemoScanSeconds": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
