{
  "ConnectionStrings": {
    "FitHubDatabase": "Host=localhost;Port=5432;Database=fithub;Username=fithub;Password=replace_with_local_password"
  },
  "Jwt": {
    "Issuer": "FitHub.Api",
    "Audience": "FitHub.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Stripe": {
    "WebBaseUrl": "http://localhost:4200"
  },
  "EquipmentDevices": {
    "HeartbeatTimeoutSeconds": 90,
    "MonitorIntervalSeconds": 30
  },
  "FaultPhotos": {
    "LocalPath": "App_Data/fault-images"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
