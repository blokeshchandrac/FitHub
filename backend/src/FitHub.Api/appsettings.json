{
  "ConnectionStrings": {
    "FitHubDatabase": "Host=localhost;Port=5432;Database=fithub;Username=fithub;Password=replace_with_local_password"
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "FitHub.Api",
    "Audience": "FitHub.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Stripe": {
    "WebBaseUrl": "http://localhost:4040"
  },
  "PasswordReset": {
    "ExpiryMinutes": 30,
    "FrontendBaseUrl": "http://localhost:4040"
  },
  "Email": {
    "Provider": "Smtp",
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "UseTls": false,
    "SenderAddress": "no-reply@fithub.local",
    "SenderName": "FitHub",
    "Brevo": {
      "ApiBaseUrl": "https://api.brevo.com",
      "TimeoutSeconds": 15
    }
  },
  "SeedData": {
    "Enabled": false,
    "Mode": "Development",
    "Accounts": [
      { "Email": "member@fithub.local", "FirstName": "Morgan", "LastName": "Member", "Role": "Member" },
      { "Email": "no-membership@fithub.demo", "FirstName": "No Membership", "LastName": "Member", "Role": "Member", "MembershipState": "None" },
      { "Email": "active-member@fithub.demo", "FirstName": "Active", "LastName": "Member", "Role": "Member", "MembershipState": "Active" },
      { "Email": "trainer@fithub.local", "FirstName": "Taylor", "LastName": "Trainer", "Role": "Trainer" },
      { "Email": "admin@fithub.local", "FirstName": "Ada", "LastName": "Admin", "Role": "Administrator" },
      { "Email": "phase2.active-member@fithub.test", "FirstName": "Priya", "LastName": "Testmember", "Role": "Member", "MembershipState": "Active" },
      { "Email": "phase2.trainer@fithub.test", "FirstName": "Theo", "LastName": "Testtrainer", "Role": "Trainer" },
      { "Email": "phase2.admin@fithub.test", "FirstName": "Amara", "LastName": "Testadmin", "Role": "Administrator" },
      { "Email": "phase2.manual-trainer@fithub.test", "FirstName": "Tariq", "LastName": "Manualtrainer", "Role": "Trainer" },
      { "Email": "phase2.manual-admin@fithub.test", "FirstName": "Amina", "LastName": "Manualadmin", "Role": "Administrator" }
